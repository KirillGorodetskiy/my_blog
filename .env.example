# Local Docker / runserver only. Production uses Doppler
# project my-blog, config prd. Do not copy this file to
# the VPS as a production secret store.

DB_NAME=myblogdb
DB_USER=myblog
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,gkablog.com,www.gkablog.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gkablog.com,https://www.gkablog.com,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:8000

NEXT_PUBLIC_SITE_URL=https://gkablog.com
INTERNAL_API_URL=http://127.0.0.1:8000

# Set to 1 when HTTPS terminates at host Nginx.
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_COOKIES=0

# Serve /media/ from Django. Use 1 for local Docker
# without host Nginx. Production must be 0.
DJANGO_SERVE_MEDIA=1

# Host path bind-mounted to /app/backend/media.
# Production: /opt/stacks/my_blog/media
MEDIA_HOST_PATH=./backend/media

# Cloudflare Turnstile. Never put the secret in frontend code.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to 1 only for local/dev tests. Never in production.
TURNSTILE_SKIP_VERIFY=0

COMMENT_RATE_PER_MINUTE=3
COMMENT_RATE_PER_10_MINUTES=10
COMMENT_RATE_PER_DAY=30

# Local pytest only. Not required for docker compose.
TEST_DB_NAME=myblogdb_test
TEST_DB_USER=myuser
TEST_DB_PASSWORD=change-me
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
