DB_NAME=myblogdb
DB_USER=myblog
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gkablog.com,www.gkablog.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gkablog.com,https://www.gkablog.com,http://localhost:3000,http://localhost:8000

NEXT_PUBLIC_SITE_URL=https://gkablog.com

# Local pytest only. Not required for docker compose.
TEST_DB_NAME=myblogdb_test
TEST_DB_USER=myuser
TEST_DB_PASSWORD=change-me
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
