# Example host Nginx config for gkablog.com.
# TLS terminates on the host. Do not put certificate
# paths or secrets in this repository.
#
# Expected local services:
#   Next.js  127.0.0.1:3000
#   Django   127.0.0.1:8000

upstream next_frontend {
    server 127.0.0.1:3000;
}

upstream django_backend {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    listen [::]:80;
    server_name gkablog.com www.gkablog.com;

    # Redirect HTTP to HTTPS at the host proxy.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gkablog.com www.gkablog.com;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /static/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Serve uploaded files from the host bind mount.
    # Do not proxy /media/ through Django in production.
    location /media/ {
        alias /opt/stacks/my_blog/media/;
        add_header X-Content-Type-Options nosniff always;
        autoindex off;
    }

    location / {
        proxy_pass http://next_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
